{
	"compilerOptions": {
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": [
		"src/**/*",
		"server.js",
		"server.ts"
	]
}